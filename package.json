{
  "name": "liblog-workspace",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:desktop": "npm run dev --workspace=apps/desktop",
    "build:desktop": "npm run build --workspace=apps/desktop",
    "preview:desktop": "npm run preview --workspace=apps/desktop",
    "dev:mobile": "npm run start --workspace=apps/mobile",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:pbt": "vitest run tests/pbt/",
    "test:unit": "vitest run tests/unit/"
  },
  "devDependencies": {
    "fast-check": "^3.22.0",
    "typescript": "^5.7.0",
    "vitest": "^3.1.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rico-rbls/LibLogApp.git"
  },
  "author": "Ric Robles",
  "license": "ISC"
}
